<style>
    {% for block in section.blocks %}
      {% assign color_name = block.settings.title %}
      [data-color-name="{{ color_name }}"],
      [data-color-name="{{ color_name }}"] > label {
        display: inline-block;
        width: 16px;
        height: 16px;
        margin: 2px;
        position: relative;
        border-radius: 50%;
        border: var(--variant-pills-border-width) solid rgba(var(--color-foreground), var(--variant-pills-border-opacity));
        background-color: {{ block.settings.color }} !important;
        {% if block.settings.image != blank %}
          background-image: url('{{ block.settings.image | img_url: '16px' }}') !important;
        {% endif %}
        cursor: pointer;
        transition: all .5s cubic-bezier(.215,.61,.355,1);
      }
      [data-color-name="{{ color_name }}"]:checked + label::after {
        border: 1px solid #000 !important;
        display: inline-block;
      }
      .color-swatches__wrapper {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        padding-top: 5px;
        padding-bottom: 12px;
      }
      .color_alt_ {
        display: none;
      }
      fieldset.product-form__input .form__label {
        display: none;
      }
      .product__info-wrapper fieldset.product-form__input .form__label {
        display: block;
        font-size: 18px;
        color: #000;
      }
    {% endfor %}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.color-swatches__wrapper .color_EnableStock_').forEach( item => {
      const colorName = item.getAttribute('data-color-name');
      if (colorName.indexOf('&') !== -1) {
        const colors = colorName.split(' & ');
        if (window.matchMedia("(max-width: 768px)").match) {
          item.style.width = '32px';
          item.style.height = '32px';
        } else {
          item.style.width = '0px';
          item.style.height = '0px';
        }
        item.style.borderRadius = '50%';
        if (colors[1] == 'Beige') {
          colors[1] = '#DDBF99'
        }
        if (colors[1] == 'Blue') {
          colors[1] = '#012350'
        }
        if (colors[1] == 'Pink') {
          colors[1] = '#FDCED6'
        }
        if (colors[0] == 'Ivory') {
          colors[1] = '#EDE1BC'
        }
        item.style.background = `linear-gradient(to right, ${colors[0]} 50%, ${colors[1]} 50%)`;
      } 
  
    })
  });

  

</script>
  
{% schema %}
  {
    "name": "Color swatch",
    "class": "color-swatch",
    "settings": [],
    "blocks": [
      {
        "type": "color",
        "name": "Color",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Name"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "default": "transparent"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Color swatch"
      }
    ]
  }
{% endschema %}
  